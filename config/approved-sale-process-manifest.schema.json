{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/approved-sale-process-manifest-v1.json",
  "title": "Approved normalized sale-process manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_id",
    "status",
    "review",
    "sources",
    "asset",
    "organizations",
    "event",
    "process",
    "roles",
    "rounds",
    "participations",
    "participation_members",
    "submissions",
    "funding",
    "decisions",
    "milestones"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "const": "APPROVED"
    },
    "review": {
      "type": "object",
      "required": [
        "reviewed_by",
        "reviewed_at",
        "approved_by",
        "approved_at"
      ],
      "properties": {
        "reviewed_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "asset": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "required": [
            "canonical_name"
          ],
          "properties": {
            "canonical_name": {
              "type": "string"
            },
            "asset_class_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "road_address": {
              "type": [
                "string",
                "null"
              ]
            },
            "jibun_address": {
              "type": [
                "string",
                "null"
              ]
            },
            "status_code": {
              "type": "string"
            }
          }
        }
      ]
    },
    "organizations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "canonical_name",
              "organization_type"
            ],
            "properties": {
              "canonical_name": {
                "type": "string"
              },
              "organization_type": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "required": [
            "canonical_title",
            "current_stage_code"
          ],
          "properties": {
            "canonical_title": {
              "type": "string"
            },
            "current_stage_code": {
              "type": "string"
            },
            "event_date_start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "event_date_end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "date_precision": {
              "type": "string"
            }
          }
        }
      ]
    },
    "process": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "type": "object",
          "required": [
            "process_code",
            "sale_method",
            "process_status"
          ],
          "properties": {
            "process_code": {
              "type": "string"
            },
            "sale_method": {
              "type": "string"
            },
            "process_status": {
              "type": "string"
            },
            "currency_code": {
              "type": "string"
            }
          }
        }
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "organization_id",
              "role_code"
            ]
          }
        ]
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "round_no",
              "round_code",
              "round_type"
            ],
            "properties": {
              "round_no": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      }
    },
    "participations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "round_id",
              "bidder_organization_id",
              "participation_status"
            ]
          }
        ]
      }
    },
    "submissions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "claim_id",
              "participation_id",
              "amount"
            ],
            "properties": {
              "claim_id": {
                "$ref": "#/$defs/id"
              },
              "participation_id": {
                "$ref": "#/$defs/id"
              },
              "amount": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/amount"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "funding": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "submission_id",
              "funding_type"
            ]
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "decision_type"
            ]
          }
        ]
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "milestone_code"
            ]
          }
        ]
      }
    },
    "participation_members": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/record"
          },
          {
            "type": "object",
            "required": [
              "participation_id",
              "organization_id",
              "member_role"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_ids"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "url",
        "publisher",
        "document_type",
        "published_at",
        "accessed_at",
        "rights_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "enum": [
            "ARTICLE",
            "PRESS_RELEASE",
            "DISCLOSURE",
            "NOTICE",
            "BID_NOTICE",
            "REPORT",
            "RSS_ITEM",
            "API_RECORD",
            "LEGAL_DOCUMENT",
            "OTHER"
          ]
        },
        "published_at": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string"
        },
        "rights_status": {
          "enum": [
            "FULL_STORAGE_ALLOWED",
            "EXCERPT_ALLOWED",
            "METADATA_ONLY",
            "MANUAL_ACCESS",
            "UNKNOWN"
          ]
        },
        "title": {
          "type": "string"
        }
      }
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "amount": {
      "type": "object",
      "required": [
        "kind",
        "raw_value",
        "currency"
      ],
      "properties": {
        "kind": {
          "enum": [
            "EXACT",
            "APPROX",
            "RANGE",
            "AT_LEAST",
            "AT_MOST",
            "GREATER_THAN",
            "LESS_THAN",
            "UNKNOWN"
          ]
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "decimal": {
          "$ref": "#/$defs/decimal"
        },
        "lower_decimal": {
          "$ref": "#/$defs/decimal"
        },
        "upper_decimal": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "price_basis": {
          "type": "string"
        },
        "vat_inclusion": {
          "type": "string"
        },
        "debt_assumption": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "EXACT",
                  "APPROX",
                  "AT_LEAST",
                  "AT_MOST",
                  "GREATER_THAN",
                  "LESS_THAN"
                ]
              }
            }
          },
          "then": {
            "required": [
              "decimal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RANGE"
              }
            }
          },
          "then": {
            "required": [
              "lower_decimal",
              "upper_decimal"
            ]
          }
        }
      ]
    }
  }
}
