# Server-side runtime. Never prefix database credentials with NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DASHBOARD_SESSION_SECRET= # 32 bytes or longer; runtime secret only

# Optional query timeout in milliseconds (1,000-30,000; default 8,000).
TURSO_QUERY_TIMEOUT_MS=8000

# Optional local authority file; use an absolute path outside the repository.
# Production should provide TURSO_DATABASE_URL and TURSO_AUTH_TOKEN directly.
TURSO_ENV_FILE=

# Optional operator and smoke-test inputs. These are not application secrets.
DASHBOARD_APPROVED_EMAILS_JSON=[]
DASHBOARD_APPROVED_BY=
DASHBOARD_SMOKE_EMAIL=
