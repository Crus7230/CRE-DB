# Hosted runtime: purpose-specific public RPCs authenticated by a server-only key.
# Never prefix database credentials with NEXT_PUBLIC_.
DASHBOARD_DATA_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_SECRET_KEY=
DASHBOARD_SUPABASE_RPC_SCHEMA=public
DASHBOARD_SESSION_SECRET= # 32 bytes or longer; runtime secret only

# Bounded query timeout in milliseconds (1,000-30,000; default 8,000).
DASHBOARD_QUERY_TIMEOUT_MS=8000

# Optional central authority file for local operation. Production should set
# every Supabase value directly and must not combine it with this file.
DASHBOARD_ENV_FILE=

# Explicit local split-snapshot mode only. Hosted deployments reject sqlite.
# DASHBOARD_DATA_PROVIDER=sqlite
# DASHBOARD_DATASET_VERSION=
# TURSO_DATABASE_URL=file:///absolute/path/to/local-access.db
# NEWS_DATABASE_URL=file:///absolute/path/to/news.db
# TIMESERIES_DATABASE_URL=file:///absolute/path/to/timeseries.db

# Optional operator and smoke-test inputs. These are not application secrets.
DASHBOARD_APPROVED_EMAILS_JSON=[]
DASHBOARD_APPROVED_BY=
DASHBOARD_SMOKE_EMAIL=
